      "url": "./?do=forge",
      "icons": [
        {
          "src": "assets/app/shortcut-forge-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "판매하기",
      "short_name": "판매",
      "description": "지금 무기를 판매 (비싼 무기는 한 번 더 확인)",
      "url": "./?do=sell",
      "icons": [
        {
          "src": "assets/app/shortcut-sell-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ]
